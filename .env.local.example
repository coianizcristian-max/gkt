# Copia questo file in ".env.local" e incolla i valori del TUO progetto Supabase
# (Supabase -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Analytics PostHog (opzionale: se mancano, il tracking resta semplicemente spento,
# nessun errore). Crea un progetto gratuito su https://posthog.com, poi:
# Project Settings -> Project API Key
NEXT_PUBLIC_POSTHOG_KEY=phc_xxxxxxxxxxxxx
# Se il progetto PostHog è in EU lascia questo valore, altrimenti usa https://us.i.posthog.com
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
